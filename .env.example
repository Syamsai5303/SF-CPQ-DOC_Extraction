# ---------- App ----------
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# ---------- Database ----------
# Matches the `db` service in docker-compose.yml
DATABASE_URL=postgresql://user:password@localhost:5433/cpq_rca

# ---------- Secrets (generate with: npm run gen:secrets) ----------
# >= 32 characters
JWT_SECRET=<random-32-char-secret>
# 64 hex chars = 32 bytes, used for AES-256-GCM encryption of Salesforce credentials.
# Changing it makes previously saved Salesforce credentials undecryptable.
ENCRYPTION_KEY=<32-byte-hex-key-for-aes-256>
# Key rotation: put the OLD key here (comma-separate several) so existing secrets still decrypt;
# they are re-encrypted with ENCRYPTION_KEY on use. Remove once the startup log is clean.
# ENCRYPTION_KEY_PREVIOUS=
JWT_EXPIRES_IN=7d

# ---------- Email (forgot password) ----------
# Leave SMTP_HOST empty locally: reset links are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CPQ to RCA <no-reply@example.com>"
RESET_TOKEN_TTL_MINUTES=30

# ---------- AI assessment (Google Gemini) ----------
# Get a key at https://aistudio.google.com/apikey . Leave empty to disable report generation.
GEMINI_API_KEY=
# Preferred model. If it is retired for your key (404) or overloaded (503/timeout), the app
# falls back to GEMINI_FALLBACK_MODELS, then to the newest gemini-X.Y-flash your key can use.
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-3.1-flash-lite
# GEMINI_THINKING_LEVEL=LOW              # Gemini 3+: MINIMAL | LOW | MEDIUM | HIGH
# GEMINI_FIRST_CHUNK_TIMEOUT_MS=120000   # give up on a model that produces nothing for this long
# GEMINI_MAX_OUTPUT_TOKENS=32768
# GEMINI_MAX_INPUT_TOKENS=400000
# GEMINI_THINKING_BUDGET=4096

# ---------- CPQ catalog extraction ----------
# CPQ_MAX_RECORDS_PER_OBJECT=250000   # safety cap per object (marked "capped" in the inventory)
# CPQ_MAX_CONCURRENT_EXTRACTIONS=2    # per app instance
# CPQ_KEEP_EXTRACTIONS=10             # extraction history kept per connection
# Development only: extract from a synthetic CPQ org instead of Salesforce (see npm run seed:demo).
# CPQ_DEMO_ORG=true
# CPQ_DEMO_PRODUCTS=3000

# ---------- Optional ----------
# SF_API_VERSION=62.0
# SF_TIMEOUT_MS=20000
# Comma-separated host suffixes the app may call when testing connections (SSRF guard)
# SF_ALLOWED_HOST_SUFFIXES=salesforce.com,force.com,cloudforce.com,salesforce.mil,sfcrmproducts.cn,salesforce-setup.com
# COOKIE_SECURE=true        # defaults to true when APP_URL is https
# TRUST_PROXY=1             # defaults to 1 in production (App Runner / ALB)
# BCRYPT_ROUNDS=12
