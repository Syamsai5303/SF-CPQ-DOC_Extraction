{
  "name": "cpq-to-rca",
  "version": "0.2.0",
  "private": true,
  "description": "CPQ to RCA - Step 1: user auth + secure Salesforce connection management",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch-path=server server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "start:migrate": "prisma migrate deploy && node server/index.js",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "prisma:generate": "prisma generate",
    "gen:secrets": "node scripts/gen-secrets.js",
    "test": "node --test \"server/**/*.test.{js,ts}\"",
    "postinstall": "prisma generate",
    "typecheck": "tsc -p tsconfig.json",
    "bench:extractor": "node scripts/bench-extractor.ts",
    "seed:demo": "node scripts/seed-demo.js"
  },
  "dependencies": {
    "@google/genai": "^3.1.0",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dejavu-fonts-ttf": "^2.37.3",
    "docx": "^9.15.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsforce": "^3.13.1",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.2.0",
    "nodemailer": "^10.5.0",
    "pdfkit": "^0.20.2",
    "prisma": "^6.19.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@vitejs/plugin-react": "^5.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^7.3.8"
  }
}
