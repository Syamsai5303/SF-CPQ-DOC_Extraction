{
  // Type-checking only: Node runs the .ts files directly via built-in type stripping
  // (Node >= 22.18), so there is no compile step. Run: npm run typecheck
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "scripts/**/*.ts"]
}
